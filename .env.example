# Copy this file to ".env" and change the values. NEVER commit ".env".

# Flask session signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=cybershield

# First admin account (created automatically on first start if missing)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@cybershield.local
ADMIN_PASSWORD=replace-with-your-own-strong-password

# Set to true only when serving over HTTPS
SESSION_COOKIE_SECURE=false

# Origins allowed to call /api/* from another site (comma separated)
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
